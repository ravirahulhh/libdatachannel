@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find required dependencies
find_dependency(Threads)
find_dependency(PkgConfig)

# Find libnice
pkg_check_modules(LIBNICE REQUIRED nice)
pkg_check_modules(GLIB REQUIRED glib-2.0 gio-2.0 gobject-2.0)

include("${CMAKE_CURRENT_LIST_DIR}/IceQuicTransportTargets.cmake")

check_required_components(IceQuicTransport)
